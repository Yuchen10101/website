---
import DitherImage from './DitherImage.astro';
const { number, url, title, imageSrc, description } = Astro.props;
---
<article class="project-element"><a href={url} class="project-link"><DitherImage src={imageSrc} alt={title} mode="color" /><div class="project-meta"><span>0{number}</span><h3>{title}</h3><p>{description}</p><span class="arrow">↘</span></div></a></article>
<style>
    .project-element { border-bottom: 1px solid var(--line); }.project-element:nth-child(odd) { border-right: 1px solid var(--line); }.project-link { display: block; padding: 18px; text-decoration: none; }.project-link :global(.dither-image) { aspect-ratio: 16 / 10; border: 1px solid transparent; transition: border-color 180ms steps(2), transform 220ms steps(3); }.project-meta { display: grid; grid-template-columns: 3.5rem 1fr auto; gap: 1rem; padding: 1.1rem 0 .2rem; }.project-meta > span { color: var(--muted-ink); font-size: .68rem; }.project-meta h3 { margin: 0; font-size: .83rem; font-weight: 500; line-height: 1.45; }.project-meta p { grid-column: 2 / 3; margin: .4rem 0 0; color: var(--muted-ink); font-size: .68rem; line-height: 1.6; }.project-meta .arrow { color: var(--ink); font-size: 1.1rem; }.project-link:hover :global(.dither-image) { border-color: var(--ink); transform: translate(-3px, -3px); }@media (max-width: 700px) { .project-element:nth-child(odd) { border-right: 0; }.project-link { padding: 15px 0; }.project-meta { grid-template-columns: 2.8rem 1fr auto; } }
</style>
