---
import ProjectElement from './ProjectElement.astro';
const allPosts = await Astro.glob('../pages/projects/*.md');
---
<section class="work-section" id="work"><p class="section-kicker">04 / SELECTED WORK</p><h2 class="section-heading">Work in<br />formation.</h2><div class="project-list">{allPosts.map((post, index) => <ProjectElement number={index + 1} url={post.url} title={post.frontmatter.title} imageSrc={post.frontmatter.image.url} description={post.frontmatter.description} />)}</div></section>
<style>.work-section { padding: 3rem 0 9rem; }.project-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }@media (max-width: 700px) { .project-list { grid-template-columns: 1fr; } }</style>
