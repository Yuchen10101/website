---
interface Props { src: string; alt: string; class?: string; mode?: 'mono' | 'color'; }
const { src, alt, class: className = '', mode = 'mono' } = Astro.props;
---
<div class:list={['dither-image', className]} data-mode={mode}><img src={src} alt={alt} loading="eager" decoding="async" /></div>
<style>
    .dither-image { position: relative; overflow: hidden; background: var(--sky-deep); aspect-ratio: 4 / 3; }.dither-image img { display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; filter: saturate(.82) contrast(1.07); }:global([data-theme='night']) .dither-image[data-mode='color'] img { filter: saturate(.68) brightness(.82) contrast(1.08); }
</style>
