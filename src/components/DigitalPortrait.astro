---
interface Props { src: string; alt: string; }
const { src, alt } = Astro.props;
---
<div class="digital-portrait"><img src={src} alt={alt} loading="eager" decoding="async" /><canvas aria-hidden="true"></canvas></div>
<script>
    document.querySelectorAll('.digital-portrait').forEach((holder) => {
        const image = holder.querySelector('img');
        const canvas = holder.querySelector('canvas');
        if (!(image instanceof HTMLImageElement) || !(canvas instanceof HTMLCanvasElement)) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const hash = (x: number, y: number, salt = 0) => {
            const value = Math.sin(x * 127.1 + y * 311.7 + salt * 74.7) * 43758.5453;
            return value - Math.floor(value);
        };
        let frame = 0;
        let paint: (() => void) | undefined;
        const render = () => {
            const bounds = holder.getBoundingClientRect();
            const width = Math.max(110, Math.floor(bounds.width / 2.4));
            const height = Math.max(145, Math.floor(bounds.height / 2.4));
            const source = document.createElement('canvas'); source.width = width; source.height = height;
            const input = source.getContext('2d', { willReadFrequently: true });
            const output = canvas.getContext('2d');
            if (!input || !output || !image.naturalWidth) return;
            input.drawImage(image, 0, 0, width, height);
            const pixels = input.getImageData(0, 0, width, height);
            const padX = Math.ceil(width * .86);
            const padY = Math.ceil(height * .28);
            output.canvas.width = width + padX * 2;
            output.canvas.height = height + padY * 2;
            // Keep the full photo intact, with a soft pixel fade instead of a drawn outline.
            const night = document.documentElement.dataset.theme === 'night';
            const skyHex = getComputedStyle(document.documentElement).getPropertyValue('--sky').trim();
            const skyMatch = skyHex.match(/^#([\da-f]{6})$/i);
            const skyColor = skyMatch
                ? [0, 2, 4].map((offset) => parseInt(skyMatch[1].slice(offset, offset + 2), 16))
                : [177, 210, 252];
            const bayer = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]];
            const channels = new Array<[number, number, number]>(width * height);
            for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
                const index = (y * width + x) * 4;
                const threshold = (bayer[y % 4][x % 4] - 7.5) * 1.5;
                let red = pixels.data[index] * .78 + threshold;
                let green = pixels.data[index + 1] * .86 + 5 + threshold;
                let blue = pixels.data[index + 2] * .94 + 15 + threshold;
                if (night) { red = red * .62 + 85; green = green * .72 + 72; blue = blue * .78 + 55; }
                const indexInImage = y * width + x;
                channels[indexInImage] = [red, green, blue].map((value) => Math.max(0, Math.min(255, value))) as [number, number, number];
            }
            // Precompute a few background-tinted palettes so scrolling stays light.
            const tintedColors = Array.from({ length: 5 }, (_, level) => {
                const tint = level / 4 * .88;
                return channels.map(([red, green, blue]) => `rgb(${Math.round(red * (1 - tint) + skyColor[0] * tint)},${Math.round(green * (1 - tint) + skyColor[1] * tint)},${Math.round(blue * (1 - tint) + skyColor[2] * tint)})`);
            });
            paint = () => {
                const rect = holder.getBoundingClientRect();
                const viewportCenter = window.innerHeight * .5;
                const distance = Math.abs(rect.top + rect.height * .5 - viewportCenter);
                const proximity = reduceMotion.matches ? 1 : Math.max(0, 1 - distance / (window.innerHeight * .62));
                const progress = proximity * proximity * (3 - 2 * proximity);
                const scatter = 1 - progress;
                output.clearRect(0, 0, output.canvas.width, output.canvas.height);

                for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
                    const edge = Math.min(x, y, width - 1 - x, height - 1 - y);
                    const edgeAlpha = Math.min(1, .2 + edge * .4);
                    const groupX = Math.floor(x / 3);
                    const groupY = Math.floor(y / 3);
                    const angle = hash(groupX, groupY, 29) * Math.PI * 2;
                    // Each 3x3 clump gets its own vector from its current location.
                    // This breaks the image apart without pulling the whole portrait
                    // toward a shared center (the old motion read like zooming).
                    const radius = .12 + Math.pow(hash(groupX, groupY, 31), .72) * .88;
                    const driftX = Math.cos(angle) * radius * width * .76;
                    const driftY = Math.sin(angle) * radius * height * .16;
                    const xJitter = (hash(x, y, 37) - .5) * 2.4;
                    const yJitter = (hash(x, y, 41) - .5) * 2.4;
                    const originX = padX + x;
                    const originY = padY + y;
                    const destinationX = originX + driftX + xJitter;
                    const destinationY = originY + driftY + yJitter;
                    const thinOuterCloud = hash(groupX, groupY, 43) < radius * .06 * scatter;
                    if (scatter > .015 && thinOuterCloud) continue;

                    const drawX = originX + (destinationX - originX) * scatter;
                    const drawY = originY + (destinationY - originY) * scatter;
                    output.globalAlpha = edgeAlpha * (1 - scatter * (.08 + radius * .82));
                    const tintLevel = Math.min(4, Math.round(radius * scatter * 4));
                    output.fillStyle = tintedColors[tintLevel][y * width + x];
                    if (scatter < .12) {
                        const size = hash(x, y, 47) > .975 ? 2 : 1;
                        output.fillRect(drawX, drawY, size, size);
                    } else {
                        // Rounded, individually drifting flecks make the disassembled
                        // state read as a point cloud, not a translated rectangular image.
                        const pointSize = .35 + hash(x, y, 47) * .3;
                        output.beginPath();
                        output.arc(drawX + .5, drawY + .5, pointSize, 0, Math.PI * 2);
                        output.fill();
                    }
                }
                output.globalAlpha = 1;
            };
            paint();
        };
        const queuePaint = () => {
            if (!paint || frame) return;
            frame = requestAnimationFrame(() => { frame = 0; paint?.(); });
        };
        window.addEventListener('scroll', queuePaint, { passive: true });
        window.addEventListener('resize', queuePaint, { passive: true });
        if (image.complete && image.naturalWidth) render();
        else {
            image.addEventListener('load', render, { once: true });
            image.addEventListener('error', () => console.error(`Portrait image failed to load: ${image.currentSrc || image.src}`), { once: true });
        }
        new ResizeObserver(render).observe(holder);
        new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        reduceMotion.addEventListener('change', queuePaint);
    });
</script>
<style>
    .digital-portrait { position: absolute; inset: 0; overflow: visible; }.digital-portrait img { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }.digital-portrait canvas { position: absolute; left: -86%; top: -28%; display: block; width: 272%; height: 156%; image-rendering: pixelated; }
</style>
