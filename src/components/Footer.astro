---
const assetBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="site-footer" id="contact"><p><span>05 / CONTACT</span> <a href="mailto:yuchyang@uw.edu">yuchyang@uw.edu</a> · <a href="https://github.com/Yuchen10101">github</a> · <a href={`${assetBase}My_CV.pdf`}>cv</a></p><p class="copyright">Yuchen Yang © {new Date().getFullYear()}</p></footer>
<style>
    .site-footer { width: min(1180px, calc(100% - 48px)); margin: 9rem auto 0; padding: 1.2rem 0 2rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 1rem; font-size: .72rem; }.site-footer p { margin: 0; }.site-footer span { color: var(--muted-ink); margin-right: 1rem; }.copyright { color: var(--muted-ink); }@media (max-width: 600px) { .site-footer { flex-direction: column; margin-top: 5rem; } }
</style>
