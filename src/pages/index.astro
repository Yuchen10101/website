---
import BaseLayout from '../layouts/BaseLayout.astro';
import RainSurface from '../components/RainSurface.astro';
import SelfIntroCard from '../components/SelfIntroCard.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
---
<BaseLayout pageTitle="Yuchen Yang — Robotics" showTitle={false} fullBleed={true}>
    <RainSurface />
    <div class="home-content"><SelfIntroCard /><ResearchCard /><ExperienceCard /><ProjectCard /></div>
</BaseLayout>
<style>.home-content { width: min(1180px, calc(100% - 48px)); margin: -16svh auto 0; position: relative; z-index: 2; }</style>
