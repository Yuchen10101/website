---
// projects/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectElement from '../../components/ProjectElement.astro';
const allPosts = await Astro.glob('./*.md');
const pageTitle = "Projects";
---
<BaseLayout pageTitle={pageTitle}>
	<div class="project-list">
		{allPosts.map((post, index) =>
		<ProjectElement number={index + 1} url={post.url} title={post.frontmatter.title}
		imageSrc={post.frontmatter.image.url} description={post.frontmatter.description} />)}
	</div>
</BaseLayout>

<style>
	.project-list {
		margin: 0 0 5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
		border-top: 1px solid var(--line);
	}
	
	.project-list li {
		border: 0;
	}
	</style>
